# Copie para ".env" (local) ou cadastre no Railway (Variables).

# Conexao com o PostgreSQL (Supabase ou Railway) - obrigatoria
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Porta (o Railway define sozinho)
PORT=3000

# E-mail (Gmail com "senha de app")
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=sua-senha-de-app
# EMAIL_FROM="Biblioteca Libro" <seuemail@gmail.com>

# Endereco publico do site, usado nos links dos e-mails
APP_URL=https://seu-app.up.railway.app

# Rotina diaria (lembretes + encerrar suspensoes). Padrao: todo dia as 08:00
# CRON_ATIVO=false
# CRON_HORARIO=0 8 * * *

# Ajustar colunas do banco automaticamente ao iniciar (use com cuidado)
# DB_SYNC_ALTER=true

# Mostrar cada chamada da API no console (padrao: ligado)
# LOG_REQUISICOES=false
